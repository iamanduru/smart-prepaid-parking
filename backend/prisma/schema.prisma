generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VEHICLE_OWNER
  ADMINISTRATOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(VEHICLE_OWNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
