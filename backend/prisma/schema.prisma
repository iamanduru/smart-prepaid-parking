generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VEHICLE_OWNER
  ADMINISTRATOR
}

enum ParkingSessionStatus {
  CREATED
  ACTIVE
  FEE_CALCULATED
  PAYMENT_PENDING
  AWAITING_RECHARGE
  PAID
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(VEHICLE_OWNER)

  vehicles Vehicle[]
  wallet   Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  vehicleId   String @id @default(uuid())
  plateNumber String @unique
  make        String
  model       String

  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tag             VehicleTag?
  parkingSessions ParkingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleTag {
  tagId  String @id
  status String @default("ACTIVE")

  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [vehicleId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  walletId String @id @default(uuid())

  // Stored in the smallest currency unit to avoid floating-point errors.
  balance Int @default(0)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingFacility {
  facilityId String @id @default(uuid())
  name       String
  location   String

  parkingSessions ParkingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingSession {
  sessionId String @id @default(uuid())

  entryTime DateTime?
  exitTime  DateTime?
  fee       Int?

  status ParkingSessionStatus @default(CREATED)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [vehicleId], onDelete: Restrict)

  facilityId String
  facility   ParkingFacility @relation(fields: [facilityId], references: [facilityId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
