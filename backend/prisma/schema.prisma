generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VEHICLE_OWNER
  ADMINISTRATOR
}

enum ParkingSessionStatus {
  CREATED
  ACTIVE
  FEE_CALCULATED
  PAYMENT_PENDING
  AWAITING_RECHARGE
  PAID
  CLOSED
}

enum TransactionType {
  RECHARGE
  PARKING_FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  VEHICLE_REGISTERED
  VEHICLE_TAG_LINKED
  WALLET_RECHARGED
  PARKING_ENTRY
  PARKING_EXIT
  PARKING_PAYMENT_COMPLETED
  PARKING_PAYMENT_PENDING
  PARKING_RATE_UPDATED
  ADMIN_REPORT_VIEWED
}

enum AuditResult {
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(VEHICLE_OWNER)

  vehicles Vehicle[]
  wallet   Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model Vehicle {
  vehicleId   String @id @default(uuid())
  plateNumber String @unique
  make        String
  model       String

  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tag             VehicleTag?
  parkingSessions ParkingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleTag {
  tagId  String @id
  status String @default("ACTIVE")

  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [vehicleId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  walletId String @id @default(uuid())

  balance Int @default(0)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingFacility {
  facilityId String @id @default(uuid())
  name       String
  location   String

  parkingSessions ParkingSession[]
  rates           ParkingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingSession {
  sessionId String @id @default(uuid())

  entryTime DateTime?
  exitTime  DateTime?
  fee       Int?

  status ParkingSessionStatus @default(CREATED)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [vehicleId], onDelete: Restrict)

  facilityId String
  facility   ParkingFacility @relation(fields: [facilityId], references: [facilityId], onDelete: Restrict)

  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  transactionId String @id @default(uuid())

  amount Int
  type   TransactionType
  status TransactionStatus @default(PENDING)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [walletId], onDelete: Restrict)

  parkingSessionId String?         @unique
  parkingSession   ParkingSession? @relation(fields: [parkingSessionId], references: [sessionId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParkingRate {
  rateId String @id @default(uuid())

  label      String
  minMinutes Int
  maxMinutes Int
  price      Int

  isActive Boolean @default(true)

  facilityId String
  facility   ParkingFacility @relation(fields: [facilityId], references: [facilityId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, minMinutes, maxMinutes])
}

model AuditLog {
  auditId String @id @default(uuid())

  actorId String?
  action  AuditAction
  result  AuditResult

  resourceType String?
  resourceId   String?

  details Json?

  ipAddress String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
